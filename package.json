{
  "name": "markda",
  "displayName": "Markda",
  "description": "Edit Markdown in place with a source-preserving live preview, tables, diagrams, math, images, and HTML export.",
  "version": "0.1.0",
  "publisher": "tetsuji16",
  "license": "MIT",
  "homepage": "https://github.com/tetsuji16/Markda#readme",
  "bugs": {
    "url": "https://github.com/tetsuji16/Markda/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/tetsuji16/Markda.git"
  },
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": ["Other", "Visualization"],
  "keywords": ["markdown", "wysiwym", "typora", "editor"],
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#172033",
    "theme": "dark"
  },
  "preview": true,
  "main": "./dist/extension.js",
  "extensionKind": ["ui"],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Editing and preview remain available. Workspace-controlled image destination and security settings are disabled.",
      "restrictedConfigurations": [
        "markda.image.folder",
        "markda.security.allowRemoteResources",
        "markda.security.allowUnsafeHtml"
      ]
    }
  },
  "activationEvents": [
    "onCustomEditor:markda.editor",
    "onView:markda.outline",
    "onView:markda.files"
  ],
  "scripts": {
    "clean": "node ./scripts/clean.mjs",
    "check": "tsc --noEmit",
    "build": "node ./esbuild.mjs",
    "watch": "node ./esbuild.mjs --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "package": "npm run check && npm run test && vsce package --no-dependencies --allow-missing-repository",
    "package:pre-release": "npm run check && npm run test && vsce package --pre-release --no-dependencies --allow-missing-repository",
    "publish:marketplace": "npm run check && npm run test && vsce publish --no-dependencies --allow-missing-repository",
    "publish:pre-release": "npm run check && npm run test && vsce publish --pre-release --no-dependencies --allow-missing-repository",
    "vscode:prepublish": "npm run build"
  },
  "contributes": {
    "customEditors": [
      {
        "viewType": "markda.editor",
        "displayName": "markda",
        "selector": [
          { "filenamePattern": "*.md" },
          { "filenamePattern": "*.markdown" },
          { "filenamePattern": "*.mdown" },
          { "filenamePattern": "*.mkd" },
          { "filenamePattern": "*.mkdn" },
          { "filenamePattern": "*.mdwn" },
          { "filenamePattern": "*.txt" }
        ],
        "priority": "default"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "markda",
          "title": "markda",
          "icon": "media/markda.svg"
        }
      ]
    },
    "views": {
      "markda": [
        { "id": "markda.outline", "name": "Outline" },
        { "id": "markda.files", "name": "Files" }
      ]
    },
    "commands": [
      { "command": "markda.open", "title": "Open with markda", "category": "markda" },
      { "command": "markda.newFile", "title": "New Markdown File", "category": "markda" },
      { "command": "markda.duplicate", "title": "Duplicate Document", "category": "markda" },
      { "command": "markda.toggleSourceMode", "title": "Toggle Source Code Mode", "category": "markda", "icon": "$(code)" },
      { "command": "markda.toggleFocusMode", "title": "Toggle Focus Mode", "category": "markda" },
      { "command": "markda.toggleTypewriterMode", "title": "Toggle Typewriter Mode", "category": "markda" },
      { "command": "markda.showOutline", "title": "Show Outline", "category": "markda" },
      { "command": "markda.showFiles", "title": "Show Files", "category": "markda" },
      { "command": "markda.showSearch", "title": "Find in Document", "category": "markda" },
      { "command": "markda.copyAsMarkdown", "title": "Copy as Markdown", "category": "markda" },
      { "command": "markda.pastePlainText", "title": "Paste as Plain Text", "category": "markda" },
      { "command": "markda.insertTable", "title": "Insert Table", "category": "markda" },
      { "command": "markda.insertImage", "title": "Insert Image", "category": "markda" },
      { "command": "markda.insertMathBlock", "title": "Insert Math Block", "category": "markda" },
      { "command": "markda.toggleBold", "title": "Format: Bold", "category": "markda", "icon": "$(bold)" },
      { "command": "markda.toggleItalic", "title": "Format: Italic", "category": "markda", "icon": "$(italic)" },
      { "command": "markda.toggleInlineCode", "title": "Format: Inline Code", "category": "markda", "icon": "$(code)" },
      { "command": "markda.insertLink", "title": "Format: Link", "category": "markda", "icon": "$(link)" },
      { "command": "markda.toggleBulletList", "title": "Format: Bulleted List", "category": "markda", "icon": "$(list-unordered)" },
      { "command": "markda.toggleTaskList", "title": "Format: Task List", "category": "markda", "icon": "$(checklist)" },
      { "command": "markda.filterOutline", "title": "Filter Outline", "category": "markda", "icon": "$(filter)" },
      { "command": "markda.clearOutlineFilter", "title": "Clear Outline Filter", "category": "markda", "icon": "$(clear-all)" },
      { "command": "markda.filterFiles", "title": "Filter Files", "category": "markda", "icon": "$(filter)" },
      { "command": "markda.clearFileFilter", "title": "Clear File Filter", "category": "markda", "icon": "$(clear-all)" },
      { "command": "markda.searchWorkspace", "title": "Search across Markdown Files", "category": "markda", "icon": "$(search)" },
      { "command": "markda.quickOpen", "title": "Quick Open Markdown File", "category": "markda", "icon": "$(go-to-file)" },
      { "command": "markda.showStatistics", "title": "Show Document Statistics", "category": "markda" },
      { "command": "markda.exportHtml", "title": "Export: HTML", "category": "markda" },
      { "command": "markda.exportHtmlBare", "title": "Export: HTML without styles", "category": "markda" },
      { "command": "markda.exportWithPrevious", "title": "Export with Previous Settings", "category": "markda" },
      { "command": "markda.openThemeFolder", "title": "Open Theme Folder", "category": "markda" }
    ],
    "menus": {
      "editor/title": [
        { "command": "markda.toggleSourceMode", "when": "activeCustomEditorId == markda.editor", "group": "navigation" },
        { "command": "markda.exportHtml", "when": "activeCustomEditorId == markda.editor", "group": "navigation" }
      ],
      "view/title": [
        { "command": "markda.filterOutline", "when": "view == markda.outline", "group": "navigation@1" },
        { "command": "markda.clearOutlineFilter", "when": "view == markda.outline", "group": "navigation@2" },
        { "command": "markda.filterFiles", "when": "view == markda.files", "group": "navigation@1" },
        { "command": "markda.searchWorkspace", "when": "view == markda.files", "group": "navigation@2" },
        { "command": "markda.quickOpen", "when": "view == markda.files", "group": "navigation@3" },
        { "command": "markda.clearFileFilter", "when": "view == markda.files", "group": "navigation@4" }
      ],
      "explorer/context": [
        { "command": "markda.open", "when": "resourceExtname =~ /\\.(md|markdown|mdown|mkd|mkdn|mdwn|txt)$/", "group": "open@1" }
      ]
    },
    "keybindings": [
      { "command": "markda.toggleSourceMode", "key": "ctrl+/", "mac": "cmd+/", "when": "activeCustomEditorId == markda.editor" },
      { "command": "markda.toggleFocusMode", "key": "f8", "when": "activeCustomEditorId == markda.editor" },
      { "command": "markda.toggleTypewriterMode", "key": "f9", "when": "activeCustomEditorId == markda.editor" },
      { "command": "markda.insertTable", "key": "ctrl+t", "mac": "cmd+alt+t", "when": "activeCustomEditorId == markda.editor" },
      { "command": "markda.insertMathBlock", "key": "ctrl+shift+m", "mac": "cmd+alt+b", "when": "activeCustomEditorId == markda.editor" },
      { "command": "markda.copyAsMarkdown", "key": "ctrl+shift+c", "mac": "cmd+shift+c", "when": "activeCustomEditorId == markda.editor" },
      { "command": "markda.pastePlainText", "key": "ctrl+shift+v", "mac": "cmd+shift+v", "when": "activeCustomEditorId == markda.editor" },
      { "command": "markda.toggleBold", "key": "ctrl+b", "mac": "cmd+b", "when": "activeCustomEditorId == markda.editor" },
      { "command": "markda.toggleItalic", "key": "ctrl+i", "mac": "cmd+i", "when": "activeCustomEditorId == markda.editor" },
      { "command": "markda.insertLink", "key": "ctrl+k", "mac": "cmd+k", "when": "activeCustomEditorId == markda.editor" }
    ],
    "configuration": {
      "title": "markda",
      "properties": {
        "markda.editor.autoPairMarkdown": { "type": "boolean", "default": true, "scope": "resource", "description": "Automatically pair Markdown delimiters." },
        "markda.editor.contentWidth": { "type": "integer", "default": 860, "minimum": 480, "maximum": 1800, "scope": "resource", "description": "Maximum editor content width in pixels." },
        "markda.editor.typewriterKeepCentered": { "type": "boolean", "default": true, "scope": "resource" },
        "markda.markdown.math": { "type": "boolean", "default": true, "scope": "resource" },
        "markda.markdown.diagrams": { "type": "boolean", "default": true, "scope": "resource" },
        "markda.markdown.html": { "type": "boolean", "default": true, "scope": "resource" },
        "markda.markdown.breaks": { "type": "boolean", "default": false, "scope": "resource" },
        "markda.image.folder": { "type": "string", "default": "${currentFileNameWithoutExt}.assets", "scope": "resource" },
        "markda.image.useRelativePath": { "type": "boolean", "default": true, "scope": "resource" },
        "markda.image.ensureDotSlash": { "type": "boolean", "default": false, "scope": "resource" },
        "markda.theme.light": { "type": "string", "default": "paper", "scope": "window" },
        "markda.theme.dark": { "type": "string", "default": "midnight", "scope": "window" },
        "markda.export.defaultFolder": { "type": "string", "enum": ["same", "ask"], "default": "ask", "scope": "resource" },
        "markda.export.allowFrontMatterOverrides": { "type": "boolean", "default": false, "scope": "resource" },
        "markda.security.allowRemoteResources": { "type": "string", "enum": ["never", "prompt", "always"], "default": "prompt", "scope": "resource" },
        "markda.security.allowUnsafeHtml": { "type": "boolean", "default": false, "scope": "resource" }
      }
    }
  },
  "dependencies": {
    "@codemirror/commands": "^6.8.1",
    "@codemirror/lang-markdown": "^6.3.3",
    "@codemirror/language": "^6.11.3",
    "@codemirror/search": "^6.5.11",
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.38.1",
    "@lezer/highlight": "^1.2.1",
    "@vscode/codicons": "^0.0.40",
    "dompurify": "^3.2.6",
    "katex": "^0.16.22",
    "markdown-it": "^14.1.0",
    "markdown-it-footnote": "^4.0.0",
    "markdown-it-mark": "^4.0.0",
    "markdown-it-sub": "^2.0.0",
    "markdown-it-sup": "^2.0.0",
    "markdown-it-task-lists": "^2.1.1",
    "mermaid": "^11.7.0"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.1.2",
    "@types/markdown-it-footnote": "^3.0.3",
    "@types/node": "^22.15.30",
    "@types/vscode": "^1.100.0",
    "@vscode/vsce": "^3.6.0",
    "esbuild": "^0.25.5",
    "typescript": "^5.8.3",
    "vitest": "^3.2.3"
  }
}
